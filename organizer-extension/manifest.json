{
  "manifest_version": 3,
  "name": "Bookmark Organizer (local)",
  "version": "1.0",
  "description": "One-off: reorganizes bookmarks into categorized folders.",
  "permissions": ["bookmarks"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Organize bookmarks",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
